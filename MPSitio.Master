<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MPSitio.master.cs" Inherits="PECEs.MPSitio" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title> PeCe's - Soporte Técnico</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- LOGO -->
        <div id="divLogo">
            <img id="imgLogo" runat="server" src="~/logo.png" alt="PeCe's" />
        </div>

        <!-- MENU DE NAVEGACION -->
        <div id="divMenu">
            <asp:Menu ID="mnuNavegacion" runat="server" Orientation="Horizontal" DataSourceID="sitemapMenu"></asp:Menu>
            <asp:SiteMapDataSource ID="sitemapMenu" runat="server" ShowStartingNode="false"/>
        </div>

        <!-- FORMULARIO DE BUSQUEDA AVANZADA -->
        <div id="divBusqueda">
            <asp:Label ID="lblBusqueda" runat="server" Text="Búsqueda Avanzada"></asp:Label>
            <asp:TextBox ID="txtBusquedaAvanzada" runat="server"></asp:TextBox>
            <asp:Button ID="btnBuscar" runat="server" Text="Buscar" OnClick="btnBuscar_Click" />
        </div>

        <!-- CONTENIDO DE CADA PAGINA -->
        <div id="divContenido">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
